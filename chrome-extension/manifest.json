{
  "manifest_version": 3,
  "name": "J.A.R.V.I.S. Chrome Companion",
  "version": "2.0.0",
  "description": "Enables real-time Chrome tab control, YouTube playback automation & verification, and webpage reading for J.A.R.V.I.S.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.vercel.app/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.github.com/*",
    "https://*.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://*.vercel.app/*"
    ]
  }
}
